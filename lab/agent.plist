<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>lab.gater</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/rj/dev/golab/gater/bin/server</string>
        <string>--port</string>
        <string>8888</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/rj/tmp</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- 将 ~/.local/bin 和 ~/.local/share/mise/shims 加入 PATH -->
        <!-- 注意：plist 中不支持用 ~ 简写，必须写绝对路径 /Users/你的用户名 -->
        <key>PATH</key>
        <string>/Users/rj/.local/bin:/Users/rj/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>MISE_CONFIG_DIR</key>
        <string>/Users/rj/nix-mac/mise</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/gater.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/gater.err.log</string>
</dict>
</plist>